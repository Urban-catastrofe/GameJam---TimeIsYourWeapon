:root {
}

.button {
    width: 80%;
    height: 90px;
    align-self: center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 30px;
    margin-right: 30px;
    margin-bottom: 30px;
    margin-left: 30px;
    background-color: rgba(255, 119, 0, 0);
    -unity-font-definition: url("project://database/Assets/Fonts/UnifrakturCook-Bold.ttf?fileID=12800000&guid=5ca6ec37a16b5f4b89fe9764304f9f11&type=3#UnifrakturCook-Bold");
    font-size: 45px;
    -unity-font-style: bold;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.769);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    background-image: url("project://database/Assets/Images/BOOM.png?fileID=2800000&guid=63eeab71b53d7d059a273c8478d7f7a9&type=3#BOOM");
    -unity-background-scale-mode: scale-and-crop;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}



.button:hover {
    width: 80%;
    height: 90px;
    align-self: center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 30px;
    margin-right: 30px;
    margin-bottom: 30px;
    margin-left: 30px;
    background-color: rgba(255, 119, 0, 0);
    -unity-font-definition: url("project://database/Assets/Fonts/UnifrakturCook-Bold.ttf?fileID=12800000&guid=5ca6ec37a16b5f4b89fe9764304f9f11&type=3#UnifrakturCook-Bold");
    font-size: 45px;
    -unity-font-style: bold;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.769);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    background-image: url("project://database/Assets/Images/BOOM.png?fileID=2800000&guid=63eeab71b53d7d059a273c8478d7f7a9&type=3#BOOM");
    -unity-background-scale-mode: scale-and-crop;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    scale: 1.2 1.2 1.2;
}

.button:active {
    width: 80%;
    height: 90px;
    align-self: center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 30px;
    margin-right: 30px;
    margin-bottom: 30px;
    margin-left: 30px;
    background-color: rgba(255, 119, 0, 0.78);
    -unity-font-definition: url("project://database/Assets/Fonts/UnifrakturCook-Bold.ttf?fileID=12800000&guid=5ca6ec37a16b5f4b89fe9764304f9f11&type=3#UnifrakturCook-Bold");
    font-size: 45px;
    -unity-font-style: bold;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.769);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    background-image: url("project://database/Assets/Images/BOOM.png?fileID=2800000&guid=63eeab71b53d7d059a273c8478d7f7a9&type=3#BOOM");
    -unity-background-scale-mode: scale-to-fit;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    scale: 1.2 1.2 1.2;
    background-repeat: space no-repeat;
    background-position-x: center;
}
