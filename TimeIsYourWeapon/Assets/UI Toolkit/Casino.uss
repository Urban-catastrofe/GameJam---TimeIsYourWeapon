.casino-background {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Assets/Images/Untitled.jpg?fileID=2800000&guid=eb67d2299ce94021b88b17a1add9011d&type=3#Untitled");
}

.casino-container {
    flex-grow: 1;
    width: 70%;
    height: 92%;
    max-height: 92%;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(128, 116, 86, 0.875);
    border-top-left-radius: 80px;
    border-top-right-radius: 80px;
    border-bottom-right-radius: 80px;
    border-bottom-left-radius: 80px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-left-color: rgba(0, 0, 0, 0.741);
    border-right-color: rgba(0, 0, 0, 0.741);
    border-top-color: rgba(0, 0, 0, 0.741);
    border-bottom-color: rgba(0, 0, 0, 0.741);
}

.casino-title {
    font-size: 80px;
    -unity-font-definition: url("project://database/Assets/Fonts/UnifrakturCook-Bold.ttf?fileID=12800000&guid=5ca6ec37a16b5f4b89fe9764304f9f11&type=3#UnifrakturCook-Bold");
}

.casino-time {
    font-size: 40px;
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Lato-Black.ttf?fileID=12800000&guid=b309cbdf4805ecbe58f1bb919976487f&type=3#Lato-Black");
}

.casino-columns {
    flex-grow: 1;
    flex-direction: row;
    width: 90%;
    margin-top: 10px;
}

.casino-panel {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 10px;
    margin-right: 10px;
    padding-top: 10px;
    padding-right: 20px;
    padding-bottom: 10px;
    padding-left: 20px;
    background-color: rgba(0, 0, 0, 0.2);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.casino-heading {
    font-size: 50px;
    align-self: center;
    -unity-font-definition: url("project://database/Assets/Fonts/UnifrakturCook-Bold.ttf?fileID=12800000&guid=5ca6ec37a16b5f4b89fe9764304f9f11&type=3#UnifrakturCook-Bold");
}

.casino-text {
    font-size: 30px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/Lato-Black.ttf?fileID=12800000&guid=b309cbdf4805ecbe58f1bb919976487f&type=3#Lato-Black");
}

.casino-result {
    margin-top: 20px;
    color: rgb(255, 255, 255);
}

.casino-slider {
    font-size: 30px;
    margin-bottom: 20px;
}

/* smaller version of the main menu .button */
.casino-button {
    width: 80%;
    height: 70px;
    font-size: 36px;
    margin-top: 8px;
    margin-bottom: 8px;
    justify-content: center;
}

.casino-button:hover {
    scale: 1.05 1.05 1.05;
}

.casino-button:active {
    scale: 1.05 1.05 1.05;
}

.casino-button:disabled {
    opacity: 0.4;
}

.casino-return {
    width: 30%;
    height: 80px;
    font-size: 40px;
    justify-content: center;
}

.casino-shop {
    flex-grow: 1;
}

.shop-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.shop-info {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 10px;
}

.shop-name {
    font-size: 30px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Lato-Black.ttf?fileID=12800000&guid=b309cbdf4805ecbe58f1bb919976487f&type=3#Lato-Black");
}

.shop-description {
    font-size: 22px;
    white-space: normal;
    -unity-font-definition: url("project://database/Assets/Fonts/Lato-Black.ttf?fileID=12800000&guid=b309cbdf4805ecbe58f1bb919976487f&type=3#Lato-Black");
}

.shop-buy {
    width: 150px;
    margin-left: 0;
    margin-right: 0;
}
