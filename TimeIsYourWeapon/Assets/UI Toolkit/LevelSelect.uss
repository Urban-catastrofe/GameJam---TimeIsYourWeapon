/* reuses the casino container, title and return button, see Casino.uss */

.level-scroll {
    flex-grow: 1;
    width: 90%;
    margin-top: 10px;
    margin-bottom: 10px;
}

.level-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

/* sits on top of the main menu .button */
.level-button {
    width: 340px;
    height: 120px;
    font-size: 40px;
    margin-top: 12px;
    margin-right: 12px;
    margin-bottom: 12px;
    margin-left: 12px;
    justify-content: center;
}

.level-button:hover {
    scale: 1.05 1.05 1.05;
}

.level-button:active {
    scale: 1.05 1.05 1.05;
}
