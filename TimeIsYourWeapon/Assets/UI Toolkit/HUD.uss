.root {
    flex-grow: 1;
}

.time-label {
    position: absolute;
    left: 64px;
    bottom: 20%;
    font-size: 32px;
    color: white;
    -unity-font-style: bold;
    right: auto;
    color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Fonts/Lato-Black.ttf?fileID=12800000&guid=b309cbdf4805ecbe58f1bb919976487f&type=3#Lato-Black");
}

.float-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.damage-number {
    position: absolute;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 0, 0);
    opacity: 1;
    translate: -50% 0;
    transition-duration: 0.8s;
    transition-timing-function: ease-out, ease-in;
}

.damage-number--float {
    translate: -50% -60px;
    opacity: 0;
}
