.penalty-label {
    color: rgb(255, 65, 80);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;

    position: absolute;
    white-space: nowrap;

    transition-property: translate, opacity;
    transition-duration: 2000ms;
    transition-timing-function: ease-out;
}

.penalty-label.is-visible {
    opacity: 1;
    translate: 0px -68px;
}

.time-scale-label {
    margin-top: 6px;

    color: rgb(155, 174, 198);

    font-size: 12px;
    -unity-text-align: middle-center;
}